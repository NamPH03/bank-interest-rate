# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to service account JSON key (optional if running inside GCP/Firebase or using GOOGLE_APPLICATION_CREDENTIALS)
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Resend Email Notification
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Bank Rate Monitor <alerts@yourdomain.com>
EMAIL_TO=your-email@example.com

# Signal Engine Thresholds (Configurable)
SIGNAL_MIN_BANKS=6
SIGNAL_CHANGE_THRESHOLD=0.20
SIGNAL_STRONG_THRESHOLD=0.25
SIGNAL_COOLDOWN_HOURS=24

# Log level: debug | info | warn | error
LOG_LEVEL=info
